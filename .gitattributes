# Core patches are applied to a source tree byte for byte, so git must not touch their line
# endings: a hunk whose context lines were normalised on checkout no longer matches the file
# it patches, and a core that ships any source with CRLF would stop applying.
cores/**/*.patch -text

# Build entrypoints run on Linux / in containers; keep LF even when checked out
# on Windows so the shebang and command lines stay valid.
build/*.sh text eol=lf
build/*.ps1 text eol=lf

# Card scripts run through /bin/sh on the device and in MSYS tests.
card/**/*.sh text eol=lf
*.sh text eol=lf
